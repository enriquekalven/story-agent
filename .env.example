# Google Cloud & Vertex AI
GOOGLE_CLOUD_PROJECT=project-maui
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Model configuration
STORY_AGENT_TEXT_MODEL=gemini-2.5-flash
STORY_AGENT_IMAGE_MODEL=gemini-2.5-flash-image
STORY_AGENT_VISION_QA_MODEL=gemini-2.5-flash
STORY_AGENT_TTS_MODEL=gemini-2.5-flash-preview-tts
STORY_AGENT_TTS_PROVIDER=auto
STORY_AGENT_GEMINI_TTS_VOICE=Kore

# Pipeline concurrency & quality gates
STORY_AGENT_MAX_WORKERS=4
STORY_AGENT_MAX_RETRIES=3
STORY_AGENT_MAX_QA_RETRIES=2
STORY_AGENT_VISUAL_QA=true

# Print & Drive configuration
STORY_AGENT_PDF_DPI=300
STORY_AGENT_PDF_TRIM_INCHES=8.5
STORY_AGENT_DRIVE_ROOT_FOLDER=Curious Little Minds - Published Books
STORY_AGENT_PORTFOLIO_FOLDER_ID=1b4s2-ce13jl52-a3sK6-w7t7cB4wG-xP
